#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# If running the rails server
if [ "${1}" == "bin/rails"  ] && [ "${2}" == "server" ]; then
  # With RAILS_ENV set to development or test
  [[ "$RAILS_ENV" =~ development|test ]] && {
    # But wait for db to be online and run migrations
    until pg_isready -d "$DB_URL"; do sleep 1; done
    bin/rails db:prepare
  }
  # When RAILS_ENV is not in development, build vite assets
  [[ "$RAILS_ENV" != "development" ]] && bin/vite build
fi

exec "${@}"
