{
  "uid": "rails-react-monolith-overview",
  "title": "Rails/React Monolith Overview",
  "tags": ["rails-react-monolith"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Service Up",
      "description": "Prometheus's own scrape health for the web service (up{job=\"rails-react-monolith\"}) — 1 if the last scrape of GET /metrics succeeded.",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "up{job=\"rails-react-monolith\"}", "refId": "A", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Request Rate",
      "description": "sum(rate(http_server_requests_total[5m])) — from Prometheus::Middleware::Collector, scraped at GET /metrics.",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(http_server_requests_total{job=\"rails-react-monolith\"}[5m]))", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Exception Rate",
      "description": "sum(rate(http_server_exceptions_total[5m])) — exceptions the Rack app raised, not caught anywhere in the stack.",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(http_server_exceptions_total{job=\"rails-react-monolith\"}[5m])) OR on() vector(0)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "p95 Request Duration",
      "description": "histogram_quantile(0.95, ...) over http_server_request_duration_seconds — includes the dev-mode reloader lock, see README.",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket{job=\"rails-react-monolith\"}[5m])) by (le))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1 }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP Requests by Route + Status",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_total{job=\"rails-react-monolith\"}[5m])) by (path, code)",
          "legendFormat": "{{path}} [{{code}}]",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Business metrics (custom Prometheus metrics from app/lib/notes_metrics.rb)",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Notes Created (total)",
      "description": "notes_created_total — a plain Counter, incremented once per note in Note#broadcast_created.",
      "gridPos": { "x": 0, "y": 14, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "notes_created_total OR on() vector(0)", "refId": "A", "instant": true }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Board Notes Count",
      "description": "board_notes_count{board_id} — a labeled Gauge, set to board.notes.count after every create.",
      "gridPos": { "x": 8, "y": 14, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "board_notes_count", "legendFormat": "board {{board_id}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Realtime Broadcasts",
      "description": "realtime_broadcasts_total{channel} — a labeled Counter, incremented in Broadcastable#alert_remote.",
      "gridPos": { "x": 16, "y": 14, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(realtime_broadcasts_total[5m])) by (channel)", "legendFormat": "{{channel}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops" },
        "overrides": []
      },
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Traces",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Recent Traces",
      "description": "Every span comes from opentelemetry-instrumentation-all (config/initializers/observability.rb) — no manual tracing code in the app. Click a trace to open it, then a span to jump to its linked CPU profile.",
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 11 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        { "queryType": "traceql", "query": "{resource.service.name=\"rails-react-monolith\"}", "refId": "A" }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "nested": true },
            "renameByName": {
              "traceID": "Trace ID",
              "startTime": "Start time",
              "traceService": "Service",
              "traceName": "Name",
              "traceDuration": "Duration"
            }
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "Profiles",
      "gridPos": { "x": 0, "y": 34, "w": 24, "h": 1 }
    },
    {
      "id": 14,
      "type": "flamegraph",
      "title": "CPU Flame Graph",
      "description": "Continuous CPU profile pushed by the pyroscope gem (config/initializers/observability.rb), aggregated over the dashboard's time range.",
      "gridPos": { "x": 0, "y": 35, "w": 24, "h": 14 },
      "datasource": { "type": "grafana-pyroscope-datasource", "uid": "pyroscope" },
      "targets": [
        {
          "refId": "A",
          "queryType": "profile",
          "profileTypeId": "process_cpu:cpu:nanoseconds:cpu:nanoseconds",
          "labelSelector": "{service_name=\"rails-react-monolith\"}",
          "groupBy": []
        }
      ]
    }
  ]
}
